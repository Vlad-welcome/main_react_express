:80 {
    # Корень со статикой React
    root * /srv

    # 1) API → Express (прокси)
    handle /api/* {
        reverse_proxy api:3000
    }

    # 2) SPA-fallback: всё остальное → index.html
    handle {
        try_files {path} /index.html
        file_server
    }

    # Сжатие
    encode gzip zstd
}